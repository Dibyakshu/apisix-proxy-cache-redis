load_module /usr/lib/nginx/modules/ndk_http_module.so;
load_module /usr/lib/nginx/modules/ngx_http_lua_module.so;

worker_processes 1;
daemon on;
pid __WORK__/logs/upstream.pid;
error_log __WORK__/logs/upstream-error.log warn;

events { worker_connections 4096; }

http {
    access_log off;
    lua_package_path "__ROOT__/lua/?.lua;__ROOT__/stubs/?.lua;__PLUGIN__/?.lua;__WORK__/apisix/?.lua;__WORK__/libs/?.lua;/usr/share/lua/5.1/?.lua;;";
    lua_package_cpath "/usr/lib/x86_64-linux-gnu/lua/5.1/?.so;;";
    lua_shared_dict counters 64m;
    server {
        listen 1980 backlog=4096;
        keepalive_requests 100000;
        location / { content_by_lua_block { require("runner").upstream() } }
    }
}
